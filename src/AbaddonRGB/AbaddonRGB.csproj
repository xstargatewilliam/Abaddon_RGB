<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AbaddonRGB</RootNamespace>
    <AssemblyName>AbaddonRGB</AssemblyName>
    <Product>Abaddon RGB</Product>
    <Version>0.4.4</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sensores de temperatura (CPU/GPU). A partir da 0.9.5 usa o PawnIO, não o WinRing0. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- Lista os dispositivos USB (HID) para a detecção nativa. -->
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Imagens e fontes do tema, embutidas no .exe como AbaddonRGB.Assets.<arquivo>. -->
    <EmbeddedResource Include="Assets\*.png;Assets\*.jpg;Assets\*.ttf;Assets\app.ico" LogicalName="AbaddonRGB.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AbaddonRGB.Core\AbaddonRGB.Core.csproj" />
  </ItemGroup>

</Project>
